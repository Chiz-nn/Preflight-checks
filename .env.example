# Free key from https://aistudio.google.com/apikey (no billing needed).
# Without it, the app still works and falls back to rule-based briefings.
GEMINI_API_KEY=

# Optional: comma-separated models to try in order.
# GEMINI_MODEL=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest

# Optional: NWS asks API users to identify themselves.
# NWS_USER_AGENT=preflight-checks/0.1 (you@example.com)
